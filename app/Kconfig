menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y

if LED_SUBSYSTEM

choice LED_BLINK_SLEEP_TIME
    prompt "LED blink Sleep Time"
    default LED_BLINK_SLEEP_TIME_MEDIUM
    help 
        Set LED blink sleep time in 4 options

config LED_BLINK_SLEEP_TIME_SLOW
    bool "2s (slow)"
config LED_BLINK_SLEEP_TIME_MEDIUM
    bool "1s (medium)"
config LED_BLINK_SLEEP_TIME_FAST
    bool "500ms (fast)"
config LED_BLINK_SLEEP_TIME_FASTER
    bool "250ms (fast)"
endchoice

menuconfig ADV_LED_SET
    bool "Advanced LED settings"
    default n

if ADV_LED_SET

config LED_BRIGHTNESS
	int "LED brightness (0-100)"
	default 100
	range 0 100
	help
	  Set LED brightness level from 0 to 100 (off - full)

config LED_FADE
	int "LED fade duration (ms)"
	default 500
	range 0 5000
	help
      Duration of LED fade in milliseconds

menu "Expert settings"
    visible if ADV_LED_SET
    
    config LED_DEBBUG
        bool "Enable LED debugging"
        default n
        help
            Enable/dissable LED debbuging
    
    config LED_PATTERN
        bool "Custom blink pattern"
        default n
        help
            Enable/dissable pattern customization    
        
endmenu #Expert

endif #Advanced

config LED_BLINK_SLEEP_TIME
    int 
    default 2000 if LED_BLINK_SLEEP_TIME_SLOW
    default 1000 if LED_BLINK_SLEEP_TIME_MEDIUM
    default 500 if LED_BLINK_SLEEP_TIME_FAST
    default 250 if LED_BLINK_SLEEP_TIME_FASTER
    default 0


endif # LED_SUBSYSTEM 
source "Kconfig.zephyr"